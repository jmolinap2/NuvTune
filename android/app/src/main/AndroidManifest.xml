<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Biblioteca local. No se pide acceso total al almacenamiento
         (requerimiento seccion 16). -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Necesario para leer la portada y los metadatos originales sin que el
         sistema los recorte. -->
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />

    <!-- Reproduccion con la pantalla apagada (requerimiento seccion 9.1). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Descarga de canciones en primer plano (motor heredado de NuvClip). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Instalar las actualizaciones descargadas por la propia aplicacion. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Notificacion multimedia (requerimiento seccion 9.2). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Fuentes remotas y letras por internet (requerimiento secciones 8 y 10).
      La aplicacion no usa la red para nada mas: la biblioteca local nunca sale
      del telefono (requerimiento seccion 16).
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:label="NuvTune"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:enableOnBackInvokedCallback="true">

        <!-- El archivo de regalo sale como content:// temporal y de solo
             lectura. Nunca se expone la ruta privada del cache. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.gift.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/gift_file_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />
            <!-- Los content:// de WhatsApp los procesa GiftIntentService. Si
                 Flutter intenta interpretarlos tambien como deep links,
                 GoRouter muestra primero "Page Not Found". -->
            <meta-data
                android:name="flutter_deeplinking_enabled"
                android:value="false" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.APP_MUSIC" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.APP_MUSIC" />
            </intent-filter>

            <!--
              Abrir un regalo (.nuvtune-gift) tocandolo desde WhatsApp, Drive o
              un gestor de archivos, sin pasar por el selector de la propia
              aplicacion.

              Van tres filtros y no uno porque Android exige que TODOS los
              criterios declarados dentro de un mismo <intent-filter> se
              cumplan a la vez. Un unico bloque que mezclara `mimeType` con
              `pathPattern` dejaba a NuvTune fuera de la lista "Abrir con" de
              WhatsApp: WhatsApp entrega una uri opaca
              (`content://com.whatsapp.provider.media/item/<id>`) donde el
              nombre del archivo no aparece, asi que el `pathPattern` nunca
              casaba y descartaba el filtro entero aunque el tipo MIME si
              coincidiera.

              Sigue siendo mejor esfuerzo, no una garantia, y por eso el boton
              de importar manual de la pantalla de Listas se conserva: es el
              camino que siempre funciona. La validacion real del contenido la
              hace `GiftPackager.read` + `GiftPayload.decode`, no el manifest.
            -->

            <!-- 1) Por nombre de archivo: gestores de archivos, Drive, correo,
                 cualquiera que conserve el nombre en la uri. Es el camino
                 preciso, sin falsos positivos. -->
            <intent-filter android:label="Abrir regalo de NuvTune">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.nuvtune-gift" />
                <data android:pathPattern=".*\\..*\\.nuvtune-gift" />
                <data android:pathPattern=".*\\..*\\..*\\.nuvtune-gift" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.nuvtune-gift" />
            </intent-filter>

            <!-- 2) Solo por tipo, sin mirar la ruta: es el que hace falta para
                 WhatsApp y Telegram, que anuncian el regalo como
                 `application/octet-stream` (de ahi la etiqueta "BIN"). El
                 precio es que NuvTune tambien aparece al abrir otros archivos
                 binarios sueltos; a cambio, tocar el regalo en el chat
                 funciona. -->
            <intent-filter android:label="Abrir regalo de NuvTune">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
            </intent-filter>

            <!-- 3) Compartir el archivo hacia NuvTune desde la conversacion
                 (manten pulsado el documento > Compartir). Es la salida
                 cuando el chooser de "Abrir con" no ofrece la aplicacion. -->
            <intent-filter android:label="Abrir regalo de NuvTune">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="application/json" />
            </intent-filter>
        </activity>

        <!-- El reproductor y la sesion multimedia viven aqui, no en el proceso
             de la interfaz (requerimiento seccion 9.1). android:exported debe
             ser true para que Android Auto y el asistente puedan enlazar. -->
        <service
            android:name="com.nuvtune.engine.MusicPlayerService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- Sostiene la descarga de canciones activa con su notificacion,
             fuera del ciclo de vida de la Activity. Motor heredado de
             C:\Repos\NuvClip. -->
        <service
            android:name="com.nuvtune.engine.downloader.DownloadForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Botones de auriculares y Bluetooth cuando la interfaz no esta viva
             (requerimiento seccion 9.2). -->
        <receiver
            android:name="androidx.media3.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!-- Widget de inicio (requerimiento seccion 9.2). -->
        <receiver
            android:name="com.nuvtune.engine.NuvTuneWidgetProvider"
            android:exported="false"
            android:label="NuvTune">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/nuvtune_widget_info" />
        </receiver>

        <!-- Declara la aplicacion como reproductor multimedia para Android Auto
             (requerimiento seccion 9.2). -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <queries>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>
</manifest>
