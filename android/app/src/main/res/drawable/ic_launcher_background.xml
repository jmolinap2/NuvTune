<?xml version="1.0" encoding="utf-8"?>
<!--
  Fondo del icono adaptativo. El lienzo del icono es de 108x108 y solo se ve
  con seguridad el circulo central de 72x72: el degradado se define sobre todo
  el lienzo para que no aparezcan cortes cuando el lanzador recorta en circulo,
  cuadrado redondeado o gota.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0" android:color="#FF131726" />
                <item android:offset="0.55" android:color="#FF0B0F17" />
                <item android:offset="1" android:color="#FF1E1B2E" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Halo del acento, en la esquina de donde arranca el degradado de marca. -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="30"
                android:centerY="26"
                android:gradientRadius="74">
                <item android:offset="0" android:color="#556D00FF" />
                <item android:offset="1" android:color="#006D00FF" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
