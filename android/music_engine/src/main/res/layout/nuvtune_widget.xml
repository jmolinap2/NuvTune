<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget de inicio (requerimiento seccion 9.2).

  Es un unico diseño con todas las piezas presentes; el proveedor oculta las
  que sobren segun el estilo, el tamaño real del widget y lo que el usuario
  haya elegido mostrar. Mantener seis diseños separados (dos estilos por tres
  tamaños) obligaria a repetir el mismo XML seis veces y a que cualquier
  cambio hubiera que hacerlo seis veces.

  Los colores no se fijan aqui: los aplica el proveedor en tiempo de ejecucion
  a partir de la configuracion.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Capa de fondo: el proveedor le aplica el color y la transparencia. -->
    <LinearLayout
        android:id="@+id/widget_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/nuvtune_widget_background"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Fila principal: portada, textos y, en compacto, los controles. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_cover"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/nuvtune_widget_cover_background"
                android:clipToOutline="true"
                android:contentDescription="@string/nuvtune_widget_cover"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_stat_nuvtune" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/nuvtune_widget_empty_title"
                    android:textColor="#FFFFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/nuvtune_widget_empty_artist"
                    android:textColor="#B3FFFFFF"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/widget_next_up"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textSize="11sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Controles en linea, para el tamaño compacto. -->
            <LinearLayout
                android:id="@+id/widget_inline_controls"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageButton
                    android:id="@+id/widget_inline_previous"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:contentDescription="@string/nuvtune_widget_previous"
                    android:src="@drawable/ic_widget_previous" />

                <ImageButton
                    android:id="@+id/widget_inline_play_pause"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:contentDescription="@string/nuvtune_widget_play_pause"
                    android:src="@drawable/ic_widget_play" />

                <ImageButton
                    android:id="@+id/widget_inline_next"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:contentDescription="@string/nuvtune_widget_next"
                    android:src="@drawable/ic_widget_next" />
            </LinearLayout>
        </LinearLayout>

        <!-- Progreso, con los tiempos a los lados. -->
        <LinearLayout
            android:id="@+id/widget_progress_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/widget_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/widget_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:max="1000" />

            <TextView
                android:id="@+id/widget_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Controles centrados, para los tamaños normal y grande. -->
        <LinearLayout
            android:id="@+id/widget_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/widget_shuffle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="@string/nuvtune_widget_shuffle"
                android:src="@drawable/ic_widget_shuffle"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/widget_previous"
                android:layout_width="48dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="@string/nuvtune_widget_previous"
                android:src="@drawable/ic_widget_previous" />

            <ImageButton
                android:id="@+id/widget_play_pause"
                android:layout_width="52dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="@string/nuvtune_widget_play_pause"
                android:src="@drawable/ic_widget_play" />

            <ImageButton
                android:id="@+id/widget_next"
                android:layout_width="48dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="@string/nuvtune_widget_next"
                android:src="@drawable/ic_widget_next" />

            <ImageButton
                android:id="@+id/widget_repeat"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="@string/nuvtune_widget_repeat"
                android:src="@drawable/ic_widget_repeat"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
