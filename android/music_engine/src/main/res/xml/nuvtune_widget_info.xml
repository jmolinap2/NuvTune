<?xml version="1.0" encoding="utf-8"?>
<!--
  El widget admite de 4x1 a 4x3. `minResizeHeight` corresponde a una sola fila
  de la rejilla para que el lanzador deje encogerlo hasta el tamaño compacto;
  el proveedor detecta el alto real y decide que filas dibuja.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:initialLayout="@layout/nuvtune_widget"
    android:previewLayout="@layout/nuvtune_widget"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="60dp"
    android:maxResizeHeight="300dp"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
